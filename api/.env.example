# ---------------------------------------------------------------------------
# FusionAuth
# ---------------------------------------------------------------------------

# URL base de FusionAuth (desarrollo local sin Docker)
FUSIONAUTH_BASE_URLC="http://127.0.0.1:9011"

# URL base de FusionAuth (dentro de Docker Compose, usa el nombre del servicio)
FUSIONAUTH_BASE_URL="http://host.docker.internal:9011"

# JWKS endpoint para validar firmas JWT (desarrollo local)
FUSIONAUTH_JWKS_URLL="http://127.0.0.1:9011/.well-known/jwks.json"

# JWKS endpoint para validar firmas JWT (dentro de Docker)
FUSIONAUTH_JWKS_URL="http://host.docker.internal:9011/.well-known/jwks.json"

# Client ID de la aplicación OIDC en FusionAuth
CLIENT_ID="tu-client-id-aqui"

# Client Secret de la aplicación OIDC en FusionAuth
CLIENT_SECRET="tu-client-secret-aqui"

# URI de redirección OAuth2 al backend
REDIRECT_URI="http://127.0.0.1:8030"

# Origen permitido para CORS (URL del frontend)
FRONTEND_URI="http://127.0.0.1:3000"

# ---------------------------------------------------------------------------
# Base de datos PostgreSQL
# ---------------------------------------------------------------------------

# Cadena de conexión completa para SQLModel/SQLAlchemy
# Formato: postgresql+psycopg2://usuario:password@host:puerto/nombre_db
DATABASE_URL="postgresql+psycopg2://fusionauth:fusionauth123@127.0.0.1:5432/fusionauth_db"

# Para uso dentro de Docker Compose (host = nombre del servicio de postgres)
# DATABASE_URL="postgresql+psycopg2://fusionauth:fusionauth123@database:5432/fusionauth_db"

# ---------------------------------------------------------------------------
# TMDB (The Movie Database)
# ---------------------------------------------------------------------------

# Bearer token de autenticación para la API de TMDB v3/v4
TOKEN="tu-token-tmdb-aqui"

# Endpoints de tendencias diarias
urlTrendingMovies="https://api.themoviedb.org/3/trending/movie/day"
urlTrendingTV="https://api.themoviedb.org/3/trending/tv/day"

# URL base para imágenes de TMDB (poster 500px)
BASE_IMAGE="https://image.tmdb.org/t/p/w500"
