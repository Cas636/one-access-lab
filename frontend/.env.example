# FusionAuth
VITE_CLIENT_ID=<client-id-de-fusionauth>
VITE_FUSIONAUTH_URL=http://127.0.0.1:9011

# Backend API
VITE_BACKEND_URL=http://127.0.0.1:8030

# Redirecciones OIDC (deben coincidir con la config de FusionAuth)
VITE_REDIRECT_URI=http://127.0.0.1:3000/content
VITE_REDIRECT_URI_POST_LOGOUT=http://127.0.0.1:3000

# Bitmovin Player — clave de licencia del player
VITE_BITMOVIN_KEY=<tu-bitmovin-player-key>
